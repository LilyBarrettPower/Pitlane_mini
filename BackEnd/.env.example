# Copy the values you need into .env (which is not committed to git).

# --- Existing settings ---
MONGO_URI=mongodb+srv://user:password@cluster.example.mongodb.net/pitlane
JWT_SECRET=change-me-to-a-long-random-string
PORT=5000

# --- Links in emails ---
# Where the app is opened from. Invite and password reset links point here.
# Change this when the app is hosted (e.g. https://app.yourdomain.com).
APP_URL=http://localhost:8081

# --- Email (SMTP) ---
# Leave SMTP_HOST empty to skip sending: the email and its link are printed
# in the backend console instead, which is handy for testing.
#
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=you@gmail.com
# and SMTP_PASS=an "app password" (Google Account > Security > App passwords).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pitlane Mini <no-reply@example.com>"
